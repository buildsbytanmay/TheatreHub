# ===================================================
# TheatreHub Environment Configuration
# ===================================================

# Server Settings
PORT=5000
NODE_ENV=production

# Database (MongoDB connection string)
# For local development: mongodb://localhost:27017/theatrehub
# For cloud deployment (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/theatrehub?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017/theatrehub

# JWT Secret Key (Used for encrypting and signing auth tokens)
# Generate a secure random string or run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Cloudinary Media Storage (Used for movie poster image uploads)
# Sign up free at https://cloudinary.com to get these keys from your dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Optional - used by Nodemailer to send welcome emails upon user registration)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
NODEMAILER_EMAIL=your_email@gmail.com
NODEMAILER_PASSWORD=your_gmail_app_password
